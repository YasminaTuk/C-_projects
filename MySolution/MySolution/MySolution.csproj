<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MySolution</AssemblyName>
    <RootNamespace>MySolution</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.companyname.mysolution</ApplicationId>
    <ApplicationTitle>MySolution</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidSupportedAbis>arm64-v8a</AndroidSupportedAbis>
    <CSharpShellApkUseDebugKey>True</CSharpShellApkUseDebugKey>
    <CSharpShellApkCrashReports>True</CSharpShellApkCrashReports>
    <CSharpShellApkSignatureSchemes>V2, V3</CSharpShellApkSignatureSchemes>
  </PropertyGroup>
</Project>